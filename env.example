# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
# NOTE: this project reads MONGODB_URI (not MONGO_URI) — double check
# which name your actual codebase uses before assuming this one.
# Format: mongodb+srv://<username>:<url-encoded-password>@<cluster>/<db-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_db_user:your_url_encoded_password@your-cluster.mongodb.net/church-connect?retryWrites=true&w=majority&appName=Cluster0

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Never reuse this value across environments or other projects.
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# ── Cloudinary (profile photos, sermon audio, chat file/voice uploads) ────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Stripe (Connect onboarding + member giving) ───────────────────────────
# Use TEST keys (sk_test_ / pk_test_) in every environment except real production.
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_CLIENT_ID=your_stripe_connect_client_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_ONBOARDING_REFRESH_URL=https://yourapp.example.com/onboarding/error
STRIPE_ONBOARDING_RETURN_URL=https://yourapp.example.com/onboarding/success

# Platform fee applied to each giving transaction (0.015 = 1.5%)
PLATFORM_FEE_RATE=0.015

# ── Paystack (alternate giving/payment gateway, used by verifyPayment webhook) ─
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# ── OneSignal (push notifications) ────────────────────────────────────────
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_API_KEY=your_onesignal_api_key

# ── Email (password resets, admin-created account welcome emails) ────────
SMTP_USER=your_smtp_username
SMTP_PASS=replace_with_a_unique_password_not_reused_anywhere_else
EMAIL_FROM=noreply@yourdomain.example.com

# ── Rate limiting (optional — defaults shown) ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10
